# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
# Auth: gcloud auth application-default login (or GOOGLE_APPLICATION_CREDENTIALS).

gcp_project_id     = "your-gcp-project-id"
billing_account_id = "XXXXXX-XXXXXX-XXXXXX"
alert_email        = "you@example.com"

# Optional overrides (defaults shown):
# gcp_region    = "asia-southeast1"
# github_owner  = "pebrisulistiyo"
# portal_image  = "asia-southeast1-docker.pkg.dev/your-gcp-project-id/portal/portal:latest"
